    { "id": "ph152", "text": "Me mareo",                            "context": "transporte", "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph153", "text": "¡Qué divertido el viaje!",            "context": "viajes",     "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph154", "text": "Quiero ir a la playa",                "context": "viajes",     "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph155", "text": "¿Cuándo llegamos?",                   "context": "viajes",     "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph156", "text": "Estoy en el hotel",                   "context": "viajes",     "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph157", "text": "Quiero sacar una foto",               "context": "viajes",     "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph158", "text": "Estoy de vacaciones",                 "context": "vacaciones", "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph159", "text": "No quiero regresar",                  "context": "vacaciones", "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph160", "text": "Me divertí mucho",                    "context": "vacaciones", "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph161", "text": "Quiero jugar videojuegos",            "context": "casa",       "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph162", "text": "Necesito cargar mi tablet",           "context": "casa",       "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph163", "text": "¿Puedo ver YouTube?",                 "context": "casa",       "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph164", "text": "Necesito el wifi",                    "context": "casa",       "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph165", "text": "Voy a mi cuarto",                     "context": "casa",       "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph166", "text": "Necesito espacio",                    "context": "casa",       "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph167", "text": "No me molestes",                      "context": "casa",       "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph168", "text": "¿Qué hay de cenar?",                  "context": "casa",       "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph169", "text": "Ya tengo sueño",                      "context": "rutinas",    "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph170", "text": "Quiero cuento",                       "context": "rutinas",    "subcategory": null,         "ageGroup": "early",  "level": "two_words" },
    { "id": "ph171", "text": "Buenas noches",                       "context": "rutinas",    "subcategory": null,         "ageGroup": "early",  "level": "two_words" },
    { "id": "ph172", "text": "Dulces sueños",                       "context": "rutinas",    "subcategory": null,         "ageGroup": "early",  "level": "two_words" },
    { "id": "ph173", "text": "Quiero levantarme",                   "context": "rutinas",    "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph174", "text": "No quiero levantarme",                "context": "rutinas",    "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph175", "text": "Hola",                                "context": "saludos",    "subcategory": null,         "ageGroup": "early",  "level": "one_word"  },
    { "id": "ph176", "text": "Adiós",                               "context": "saludos",    "subcategory": null,         "ageGroup": "early",  "level": "one_word"  },
    { "id": "ph177", "text": "Hasta luego",                         "context": "saludos",    "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph178", "text": "Mucho gusto",                         "context": "saludos",    "subcategory": null,         "ageGroup": "child",  "level": "two_words" },
    { "id": "ph179", "text": "¿Cómo te llamas?",                    "context": "saludos",    "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph180", "text": "Me llamo...",                         "context": "saludos",    "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph181", "text": "¿Quién es?",                          "context": "saludos",    "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph182", "text": "Tengo trabajo",                       "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph183", "text": "Voy a la oficina",                    "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph184", "text": "Tengo una junta",                     "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph185", "text": "Necesito ayuda con mi computadora",   "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph186", "text": "¿Me puedes ayudar?",                  "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph187", "text": "Terminé mi trabajo",                  "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph188", "text": "Necesito más tiempo",                 "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph189", "text": "Hoy no puedo",                        "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph190", "text": "Quiero hablar con mi jefe",           "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph191", "text": "Necesito un descanso",                "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph192", "text": "¿Dónde están las salidas?",           "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph193", "text": "¡Auxilio!",                           "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "one_word"  },
    { "id": "ph194", "text": "Llamen a una ambulancia",             "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph195", "text": "Necesito el 911",                     "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph196", "text": "Me caí y no me puedo levantar",       "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph197", "text": "Estoy sangrando",                     "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph198", "text": "No puedo respirar bien",              "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph199", "text": "Tengo una reacción alérgica",         "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph200", "text": "Me robaron",                          "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph201", "text": "Necesito a mi cuidador",              "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph202", "text": "Por favor llamen a mi familia",       "context": "doctor",     "subcategory": "emergencia", "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph203", "text": "Sí",                                  "context": "saludos",    "subcategory": null,         "ageGroup": "early",  "level": "one_word"  },
    { "id": "ph204", "text": "No",                                  "context": "saludos",    "subcategory": null,         "ageGroup": "early",  "level": "one_word"  },
    { "id": "ph205", "text": "Más",                                 "context": "saludos",    "subcategory": null,         "ageGroup": "early",  "level": "one_word"  },
    { "id": "ph206", "text": "Listo",                               "context": "saludos",    "subcategory": null,         "ageGroup": "early",  "level": "one_word"  },
    { "id": "ph207", "text": "Parar",                               "context": "saludos",    "subcategory": null,         "ageGroup": "early",  "level": "one_word"  },
    { "id": "ph208", "text": "Quiero música",                       "context": "casa",       "subcategory": null,         "ageGroup": "child",  "level": "two_words" },
    { "id": "ph209", "text": "Baja el volumen",                     "context": "casa",       "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph210", "text": "Está muy ruidoso",                    "context": "casa",       "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph211", "text": "¿Puedo hablar un momento?",           "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph212", "text": "¿Me puede explicar otra vez?",        "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph213", "text": "Necesito apoyo de comunicación",      "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph214", "text": "Tengo una condición que afecta mi habla", "context": "trabajo","subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph215", "text": "Uso un dispositivo para comunicarme", "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph216", "text": "¿Tiene tiempo para hablar?",          "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph217", "text": "Quiero decirte algo",                 "context": "familia",    "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph218", "text": "Gracias por escucharme",              "context": "familia",    "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph219", "text": "Te necesito",                         "context": "familia",    "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph220", "text": "¿Cómo estuvo tu día?",               "context": "familia",    "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph221", "text": "Mi día estuvo bien",                  "context": "familia",    "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph222", "text": "Quiero contarte algo",                "context": "familia",    "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph223", "text": "Esto me pone feliz",                  "context": "emociones",  "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
