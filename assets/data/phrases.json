    { "id": "ph248", "text": "¿Tienen rampa?",                      "context": "compras",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph249", "text": "Necesito sentarme",                   "context": "compras",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph250", "text": "Me siento cansado",                   "context": "compras",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph251", "text": "Buen trabajo",                        "context": "escuela",    "subcategory": null,         "ageGroup": "child",  "level": "two_words" },
