    { "id": "ph227", "text": "Voy a explotar",                      "context": "emociones",  "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph228", "text": "Necesito ayuda para comunicarme",     "context": "trabajo",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph229", "text": "Por favor espera",                    "context": "saludos",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph230", "text": "Estoy pensando",                      "context": "saludos",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph231", "text": "Un momento por favor",                "context": "saludos",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph232", "text": "¿Puedes esperar?",                    "context": "saludos",    "subcategory": null,         "ageGroup": "teen",   "level": "phrase"    },
    { "id": "ph233", "text": "Repite más despacio",                 "context": "saludos",    "subcategory": null,         "ageGroup": "adult",  "level": "phrase"    },
    { "id": "ph234", "text": "Mis audífonos",                       "context": "casa",       "subcategory": null,         "ageGroup": "child",  "level": "two_words" },
    { "id": "ph235", "text": "Quiero ver un video",                 "context": "casa",       "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph236", "text": "Quiero escuchar mi canción",          "context": "casa",       "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
    { "id": "ph237", "text": "Hay un perro",                        "context": "parque",     "subcategory": null,         "ageGroup": "early",  "level": "two_words" },
    { "id": "ph238", "text": "Me da miedo el perro",                "context": "parque",     "subcategory": null,         "ageGroup": "child",  "level": "phrase"    },
